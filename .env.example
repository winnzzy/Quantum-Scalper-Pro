# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-min-32-chars-long
PRIVATE_MODE=true
OWNER_EMAIL=owner@example.com
PUBLIC_REGISTRATION_ENABLED=false
COMMERCIAL_FEATURES_ENABLED=false
# Keep false through paper burn-in. Arm only after /system/launch-readiness is clear.
LIVE_TRADING_ENABLED=false
# Can be flipped to true and the backend restarted to block all new orders.
EMERGENCY_STOP=false
STARTUP_RECOVERY_REQUIRED=true
METRICS_ENABLED=false
MAX_MARKET_DATA_AGE_SECONDS=15
ORDER_IDEMPOTENCY_TTL_SECONDS=300
MIN_PAPER_TRADES_PER_MARKET=100
MIN_PAPER_BURN_IN_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://qsp_admin:SecurePass123!@localhost:5432/quantum_scalper_pro

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=RedisPass123!

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true
BINANCE_FUTURES=false

# MetaTrader 5
MT5_SERVER=your_mt5_server
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_PATH=
# Exact gold symbol exposed by your broker (examples: XAUUSD, XAUUSD.a, GOLD)
MT5_XAU_SYMBOL=XAUUSD

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# AI
AI_FILTER_ENABLED=true
AI_MIN_CONFIDENCE=0.65

# News
NEWS_FILTER_ENABLED=true
NEWS_API_KEY=your_news_api_key

# Monitoring
GRAFANA_PASSWORD=replace-with-a-strong-password
